# Copy to .env and fill in. .env is gitignored.

# DataHub (local quickstart defaults). GMS_URL/TOKEN are also passed to the
# DataHub MCP Server. Token can stay empty while quickstart auth is disabled.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Read DataHub context through the official MCP Server instead of the SDK.
# Requires `uv` installed; the server is launched via `uvx mcp-server-datahub`.
# Leave unset to use the SDK (identical results; no uv needed).
SENTINEL_USE_MCP=

# LLM (Adaptive Multi-Tier Model Routing) — OpenRouter, OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_MODEL_CODE=cohere/north-mini-code:free
OPENROUTER_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_CHAT=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FAST=nvidia/nemotron-nano-9b-v2:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub (fix-PR generation) — a fine-grained PAT with repo scope
GITHUB_TOKEN=
GITHUB_REPO=

# MLflow (local file backend)
MLFLOW_TRACKING_URI=file:./mlruns

# Slack (incident notifications + approvals)
# Create a Slack app at https://api.slack.com/apps, add bot scopes
# chat:write, chat:write.public, channels:read, reactions:write.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# App-level token for Socket Mode (interactive approvals).
# Enable Socket Mode in the app settings, generate an app-level token with
# connections:write scope. Without this, approval buttons are posted but
# clicking them has no effect — the fallback policy in config/slack.yaml applies.
SLACK_APP_TOKEN=

# Only one process may hold the Socket Mode connection — Slack delivers each
# button click to exactly one connection, so two agents running at once steal
# each other's approvals. The first process to start claims it via a lockfile.
# Set to 0 to make this process decline the socket on purpose (e.g. keep a
# long-running `serve` up while a manual run owns interactive approvals).
SENTINEL_SLACK_SOCKET=1

# Webhook secrets (HMAC-SHA256 verification for each source).
# Set these to the shared secrets configured in each external service.
# If unset, signature verification is skipped for that source.
WEBHOOK_SECRET_DBT=
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_AIRFLOW=
WEBHOOK_SECRET_GENERIC=

# PagerDuty (incident paging for HUMAN_ONLY tier).
# Create an Events API v2 integration on your PagerDuty service,
# copy the integration/routing key here.
PAGERDUTY_ROUTING_KEY=

# Supabase Auth & Database (for user login/signup in the web console)
# Create a project at https://supabase.com and copy the Project URL and Anon Public Key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
