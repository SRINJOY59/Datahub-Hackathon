# Copy to .env and fill in. .env is gitignored.

# DataHub (local quickstart defaults). GMS_URL/TOKEN are also passed to the
# DataHub MCP Server. Token can stay empty while quickstart auth is disabled.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Read DataHub context through the official MCP Server instead of the SDK.
# Requires `uv` installed; the server is launched via `uvx mcp-server-datahub`.
# Leave unset to use the SDK (identical results; no uv needed).
SENTINEL_USE_MCP=

# LLM (agent reasoning) — OpenRouter, OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub (fix-PR generation) — a fine-grained PAT with repo scope
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-demo-repo

# MLflow (local file backend)
MLFLOW_TRACKING_URI=file:./mlruns

# Slack (incident notifications + approvals)
# Create a Slack app at https://api.slack.com/apps, add bot scopes
# chat:write, chat:write.public, channels:read, reactions:write.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# App-level token for Socket Mode (interactive approvals).
# Enable Socket Mode in the app settings, generate an app-level token with
# connections:write scope. Without this, approval buttons are posted but
# clicking them has no effect — the fallback policy in config/slack.yaml applies.
SLACK_APP_TOKEN=

# Webhook secrets (HMAC-SHA256 verification for each source).
# Set these to the shared secrets configured in each external service.
# If unset, signature verification is skipped for that source.
WEBHOOK_SECRET_DBT=
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_AIRFLOW=
WEBHOOK_SECRET_GENERIC=
