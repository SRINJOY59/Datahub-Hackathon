# Copy to .env and fill in. .env is gitignored.

# DataHub (local quickstart defaults)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# LLM (agent reasoning)
ANTHROPIC_API_KEY=

# GitHub (fix-PR generation) — a fine-grained PAT with repo scope
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-demo-repo

# MLflow (local file backend)
MLFLOW_TRACKING_URI=file:./mlruns
